{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BDO-Ping-Monitor",
  "identifier": "com.bdo.pingmonitor",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BDO Ping Monitor",
        "width": 450,
        "height": 620,
        "resizable": true,
        "minWidth": 400,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["English"]
      }
    }
  }
}
